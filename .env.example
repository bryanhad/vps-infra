# Copy to .env on the server and fill in. Each hostname needs a DNS record pointing at the VPS.
RALLY_HOST=rally.example.com
STATS_HOST=stats.example.com
MONITOR_HOST=monitor.example.com

# Beszel agent: the hub's public key (Beszel UI > Add system).
BESZEL_HUB_PUBLIC_KEY=ssh-ed25519 AAAA...

# Where the rally-point repo is checked out (default: next to this repo).
# RALLY_POINT_DIR=../rally-point
# Where Beszel's data folders live (default: next to this repo).
# BESZEL_DIR=../beszel
